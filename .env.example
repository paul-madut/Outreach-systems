# Copy to .env.local and fill in. Never commit .env.local.
#
# There is deliberately very little here. Mailbox passwords live in the macOS
# Keychain, not in a file, and each mailbox row in the database names its own
# Keychain service and account.

# --- Sending safety -----------------------------------------------------
# Nothing is delivered unless this is exactly "1".
# Leave it at 0 while working on the tool: the worker still claims, renders and
# logs, so the whole pipeline runs without touching a real inbox.
OUTREACH_LIVE=0

# Reroute every outgoing message to this address, whatever the recipient says.
# Used for end-to-end tests against a real mailbox. Leave blank normally.
REDIRECT_ALL_TO=

# --- Paths --------------------------------------------------------------
# Defaults to ./outreach.db. Override to keep the database somewhere else,
# for example in an iCloud-synced folder.
# OUTREACH_DB=/Users/paulmadut/Outreach-systems/outreach.db

# Slack incoming webhook for inbound-mail alerts. Unset means no alerts;
# the worker still polls and files everything normally.
SLACK_WEBHOOK_URL=

# Anthropic API key, for drafting replies to inbound mail.
# Unset means the Draft a reply button reports it and nothing else changes.
ANTHROPIC_API_KEY=

# Only needed when the key above is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# Which model drafts replies: "sonnet" (default) or "haiku". Nothing else is
# accepted; an unknown value is refused rather than silently defaulted.
REPLY_MODEL=
